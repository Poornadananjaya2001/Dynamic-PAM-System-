# ==========================================
# SecureSafe PAM - Git Ignore Rules
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class
*.so

# C extensions
*.obj
*.o
*.pyd

# Environment secrets
.env
.env.*

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.cover
*.zip

# IDEs & Code Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary files & Export caches
log_export_*/
scratch/
*.tmp
*.log.bak
